{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAi": {
    "DraftingModel": "gpt-4.1-mini-2025-04-14",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536
  },
  "DraftLimits": {
    "MaxTurns": 20,
    "MaxTurnCharacters": 4000,
    "MaxInstructionCharacters": 2000,
    "MaxTotalCharacters": 24000,
    "MaxRequestBodyBytes": 131072
  },
  "Drafting": {
    "MaxOutputTokens": 1200,
    "MaxTranscriptCharacters": 20000,
    "RetrievalCharacterAllowance": 24000,
    "MaxPromptCharacters": 80000
  },
  "Knowledge": {
    "Endpoint": "https://gorgias-assistant-search.search.windows.net",
    "IndexName": "knowledge-v1",
    "SemanticConfiguration": "policy-semantic",
    "VectorCandidates": 20,
    "TicketIndexName": "tickets-v2"
  },
  "Retrieval": {
    "Enabled": true,
    "PolicyTopK": 4,
    "TemplateTopK": 2,
    "InternalTopK": 2,
    "TicketTopK": 0,
    "MinimumPolicyScore": 1.6
  },
  "Shell": {
    "KillSwitch": false,
    "MinShellVersion": "0.1.0",
    "AnchorProbes": []
  }
}
